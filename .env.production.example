APP_NAME="Nomas Apparel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nomas.elgontech.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Truhost: create database + user in cPanel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_CPANEL_USERNAME_nomas
DB_USERNAME=YOUR_CPANEL_USERNAME_nomas
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=nomas.elgontech.co.ke
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.elgontect.co.ke
MAIL_PORT=587
MAIL_USERNAME=hello@elgontect.co.ke
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@elgontect.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PWA_ENABLED=true
PWA_THEME_COLOR="#16456e"
PWA_BACKGROUND_COLOR="#ffffff"
PWA_CACHE_VERSION=1
PWA_ADMIN_THEME_COLOR="#121212"
PWA_ADMIN_BACKGROUND_COLOR="#121212"
PWA_ADMIN_START_URL="/admin/pos"
