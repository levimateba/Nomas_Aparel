# Production Environment Configuration Template
# Copy this file to .env and update the values for your production server

APP_NAME="Elgon Tech"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging - Use daily for production
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning # Use 'warning' or 'error' in production

# Database Configuration - Update with your production database
DB_CONNECTION=mysql
DB_HOST=your-database-host.com
DB_PORT=3306
DB_DATABASE=elgon_tech_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Session Configuration
SESSION_DRIVER=database # Use database for better session handling
SESSION_LIFETIME=120
SESSION_ENCRYPT=true # Enable encryption
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com # Set to your domain

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem Configuration - Use S3 for production file uploads
FILESYSTEM_DISK=s3 # Change from 'local' to 's3' for cloud storage

# Queue Configuration - Use database or redis
QUEUE_CONNECTION=database # Use 'redis' for better performance

# Cache Configuration - Use redis or memcached
CACHE_STORE=redis # Change from 'database' to 'redis'
CACHE_PREFIX=elgon_tech_

# Redis Configuration (if using Redis for cache/session)
REDIS_CLIENT=phpredis
REDIS_HOST=your-redis-host.com
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# Mail Configuration - Use SMTP provider
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com # Or your email provider
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS="noreply@elgontech.com"
MAIL_FROM_NAME="Elgon Tech"

# AWS S3 Configuration (if using S3 for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-bucket-name
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"
